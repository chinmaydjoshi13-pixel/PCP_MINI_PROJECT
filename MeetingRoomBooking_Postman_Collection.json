{
  "info": {
    "name": "Meeting Room Booking - Test Cases",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "TC01 POST booking",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/bookings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookings"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 1,\n  \"roomId\": 2,\n  \"purpose\": \"Sprint Planning\",\n  \"attendeeCount\": 4,\n  \"startTime\": \"2026-12-15T10:00:00\",\n  \"endTime\": \"2026-12-15T11:00:00\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function(){ pm.response.to.have.status(201); });"
            ]
          }
        }
      ]
    },
